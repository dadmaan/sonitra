# Path to your local notes directory (used by the Obsidian notes mount).
# This should be an absolute path on the host machine.
# Default (if unset): ../.local/notes relative to the compose file.
LOCAL_NOTES_DIR=C:\Users\YourUser\Documents\Obsidian\dev\sonitra

# Node.js memory limit in MB. Reduce if your host is low on RAM.
NODE_MAX_OLD_SPACE=4096

# Host port for the Sonitra API server (mapped to container port 8000).
FORWARD_PORT_API=8000

# Host port for Jupyter Lab (mapped to container port 8888).
JUPYTER_PORT=8888

# Set to "false" to skip starting Jupyter Lab in the container.
JUPYTER_ENABLED=true
