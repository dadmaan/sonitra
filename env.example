# Path to the pipeline config YAML inside the container.
# The entrypoint symlinks this to /app/config/source.yaml at startup.
# SONITRA_CONFIG=/app/config/config.yaml

# Uvicorn log level (debug, info, warning, error, critical).
# LOG_LEVEL=info

# UID/GID of the host user, baked into the container's non-root `sonitra`
# user at build time so bind-mounted ./corpus, ./config, ./output keep your
# ownership instead of being rewritten to a container-only UID. Required on
# native Linux hosts (e.g. a remote server); safe to leave unset on Docker
# Desktop for macOS/Windows. Set with:
#   echo "HOST_UID=$(id -u)" >> .env && echo "HOST_GID=$(id -g)" >> .env
# HOST_UID=1000
# HOST_GID=1000
